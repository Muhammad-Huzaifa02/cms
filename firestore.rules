rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return request.auth != null && userDoc().isAdmin == true; }
    function isActive() { return request.auth != null && userDoc().active == true; }
    function can(perm) {
      return isActive() && (isAdmin() || userDoc().permissions[perm] == true);
    }

    function isPakistaniPhone(p) {
      return p is string && p.matches('^03[0-9]{9}$');
    }
    function isCnic(c) {
      return c is string && c.matches('^[0-9]{13}$');
    }
    function isAccountNumber(a) {
      return a is string && a.matches('^[0-9]{14}$');
    }

    match /customers/{accountNumber} {
      allow read: if can('view');

      allow create: if can('add')
        && isAccountNumber(accountNumber)
        && request.resource.data.accountNumber == accountNumber
        && isPakistaniPhone(request.resource.data.phone)
        && isCnic(request.resource.data.cnic)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActivityId is string
        && request.resource.data.deleteActivityId is string
        && getAfter(/databases/$(database)/documents/activityLog/$(request.resource.data.lastActivityId)).data.action == 'customer_created'
        && getAfter(/databases/$(database)/documents/activityLog/$(request.resource.data.lastActivityId)).data.targetId == accountNumber;

      allow update: if can('edit')
        && isAccountNumber(accountNumber)
        && request.resource.data.accountNumber == resource.data.accountNumber
        && isPakistaniPhone(request.resource.data.phone)
        && isCnic(request.resource.data.cnic)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.lastActivityId is string
        && request.resource.data.deleteActivityId == resource.data.deleteActivityId
        && getAfter(/databases/$(database)/documents/activityLog/$(request.resource.data.lastActivityId)).data.action == 'customer_updated'
        && getAfter(/databases/$(database)/documents/activityLog/$(request.resource.data.lastActivityId)).data.targetId == accountNumber;

      allow delete: if can('delete')
        && resource.data.deleteActivityId is string
        && getAfter(/databases/$(database)/documents/activityLog/$(resource.data.deleteActivityId)).data.action == 'customer_deleted'
        && getAfter(/databases/$(database)/documents/activityLog/$(resource.data.deleteActivityId)).data.targetId == accountNumber;
    }

    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      allow create: if isAdmin() || (
        request.auth.uid == uid
        && request.resource.data.isAdmin == true
        && request.resource.data.createdBy == uid
        && get(/databases/$(database)/documents/system/bootstrap).data.adminExists == false
      );

      allow update: if isAdmin() || (
        request.auth.uid == uid
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.permissions == resource.data.permissions
        && request.resource.data.active == resource.data.active
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
      );
      allow delete: if isAdmin();
    }

    match /system/bootstrap {
      allow read: if true;
      allow create: if request.resource.data.adminExists == false;
      allow update: if request.auth != null
        && resource.data.adminExists == false
        && request.resource.data.adminExists == true
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /activityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isActive()
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.timestamp == request.time
        && request.resource.data.action in ['customer_created', 'customer_updated', 'customer_deleted', 'staff_created', 'staff_permissions_changed', 'staff_removed', 'export'];
      allow update, delete: if false;
    }

    match /phoneIndex/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && (
        request.resource.data.uid == request.auth.uid || isAdmin()
      );
      allow delete: if isAdmin() || (
        request.auth != null && resource.data.uid == request.auth.uid
      );
      allow update: if isAdmin();
    }
  }
}
