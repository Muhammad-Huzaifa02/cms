rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return request.auth != null && userDoc().isAdmin == true; }
    function isActive() { return request.auth != null && userDoc().active == true; }
    function can(perm) {
      return isActive() && (isAdmin() || userDoc().permissions[perm] == true);
    }

    match /customers/{accountNumber} {
      allow read:   if can('view');
      allow create: if can('add');
      allow update: if can('edit');
      allow delete: if can('delete');
    }

    match /users/{uid} {
      allow read: if request.auth.uid == uid || isAdmin();
      // Two ways a `users/{uid}` doc gets created:
      // 1. Self-bootstrap — the very first Admin, once, before any Admin
      //    exists (guarded by /system/bootstrap).
      // 2. An existing Admin creating a STAFF account. This runs entirely
      //    client-side: the new Auth account is created on a temporary
      //    SECOND Firebase app instance (so Admin's own session on the
      //    default app is never disturbed — see
      //    AuthService.createStaffAccount), then this Firestore write
      //    happens on the default app under Admin's own still-valid
      //    session, authorized by isAdmin() below.
      allow create: if isAdmin() || (
        request.auth.uid == uid
        && request.resource.data.isAdmin == true
        && get(/databases/$(database)/documents/system/bootstrap).data.adminExists == false
      );

      // Allow Admins to manage all users, and users to update their own basic info
      allow update: if isAdmin() || (
        request.auth.uid == uid
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.permissions == resource.data.permissions
        && request.resource.data.active == resource.data.active
      );
      allow delete: if isAdmin();
    }

    match /system/bootstrap {
      allow read: if true;
      // Anyone can create the flag doc itself, but only ever as "false" —
      // this just lets the app auto-create it on first run with no manual
      // Firebase Console step required.
      allow create: if request.resource.data.adminExists == false;
      // Flipping it to true only happens as part of the bootstrap admin
      // being created (see AuthService.bootstrapFirstAdmin), and only
      // ever false -> true, never back.
      allow update: if request.auth != null
        && resource.data.adminExists == false
        && request.resource.data.adminExists == true;
    }

    match /activityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isActive();
      allow update, delete: if false;
    }

    match /phoneIndex/{phone} {
      allow read: if true;
      // Allow creation if the user is registering themselves, or if an Admin is doing it
      allow create: if request.auth != null && (
        request.resource.data.uid == request.auth.uid || isAdmin()
      );
      // Allow deletion if it's the user's own entry (for phone changes) or if Admin
      allow delete: if isAdmin() || (
        request.auth != null && resource.data.uid == request.auth.uid
      );
      allow update: if isAdmin();
    }
  }
}
