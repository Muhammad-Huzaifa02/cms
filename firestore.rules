rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && userDoc().isAdmin == true; }
    function isActive() { return signedIn() && userDoc().active == true; }
    function can(perm) {
      return isActive() && (isAdmin() || userDoc().permissions[perm] == true);
    }

    function isPakistaniPhone(p) {
      return p is string && p.matches('^03[0-9]{9}$');
    }
    function isCnic(c) {
      return c is string && c.matches('^[0-9]{13}$');
    }
    function isAccountNumber(a) {
      return a is string && a.matches('^[0-9]{14}$');
    }
    function isIbnNo(n) {
      return n is string && n.matches('^[A-Z0-9]{24}$');
    }

    function activityMatches(logId, action, targetId) {
      return logId is string
        && existsAfter(/databases/$(database)/documents/activityLog/$(logId))
        && getAfter(/databases/$(database)/documents/activityLog/$(logId)).data.action == action
        && getAfter(/databases/$(database)/documents/activityLog/$(logId)).data.targetId == targetId
        && getAfter(/databases/$(database)/documents/activityLog/$(logId)).data.performedBy == request.auth.uid;
    }

    function validActivityShape() {
      return request.resource.data.keys().hasAll(['action', 'targetId', 'performedBy', 'performedByName', 'timestamp'])
        && request.resource.data.performedBy == request.auth.uid
        && request.resource.data.timestamp == request.time;
    }

    match /customers/{accountNumber} {
      allow read: if can('view');

      allow create: if can('add')
        && isAccountNumber(accountNumber)
        && request.resource.data.accountNumber == accountNumber
        && isPakistaniPhone(request.resource.data.phone)
        && isCnic(request.resource.data.cnic)
        && isIbnNo(request.resource.data.ibnNo)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && activityMatches(request.resource.data.lastActivityId, 'customer_created', accountNumber);

      allow update: if can('edit')
        && isAccountNumber(accountNumber)
        && request.resource.data.accountNumber == resource.data.accountNumber
        && isPakistaniPhone(request.resource.data.phone)
        && isCnic(request.resource.data.cnic)
        && isIbnNo(request.resource.data.ibnNo)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && activityMatches(request.resource.data.lastActivityId, 'customer_updated', accountNumber)
        || (isAdmin()
          && request.resource.data.accountNumber == resource.data.accountNumber
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'accountTitleSearchWords',
            'phoneLast4',
            'cnicLast4',
            'accountNumberLast4',
            'deleteActivityId'
          ])
          && request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'accountTitleSearchWords',
            'phoneLast4',
            'cnicLast4',
            'accountNumberLast4',
            'deleteActivityId'
          ]));

      allow delete: if can('delete')
        && activityMatches(resource.data.deleteActivityId, 'customer_deleted', accountNumber);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if (
        request.auth.uid == uid
        && request.resource.data.isAdmin == true
        && request.resource.data.createdBy == uid
        && get(/databases/$(database)/documents/system/bootstrap).data.adminExists == false
      ) || (
        isAdmin()
        && request.resource.data.isAdmin == false
        && request.resource.data.createdBy == request.auth.uid
        && activityMatches(request.resource.data.lastActivityId, 'staff_created', uid)
      );

      allow update: if (
        signedIn() && request.auth.uid == uid
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.active == resource.data.active
        && request.resource.data.permissions == resource.data.permissions
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
      ) || (
        isAdmin()
        && resource.data.isAdmin == false
        && request.resource.data.isAdmin == false
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions'])
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['active'])
            && request.resource.data.permissions != resource.data.permissions
            && activityMatches(request.resource.data.lastActivityId, 'staff_permissions_changed', uid))
          || (request.resource.data.diff(resource.data).affectedKeys().hasAny(['active'])
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['permissions'])
            && request.resource.data.active != resource.data.active
            && activityMatches(request.resource.data.lastActivityId, 'staff_removed', uid))
        )
      );

      allow delete: if false;
    }

    match /system/bootstrap {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['adminExists'])
        && request.resource.data.adminExists == false;
      allow update: if signedIn()
        && resource.data.adminExists == false
        && request.resource.data.keys().hasOnly(['adminExists'])
        && request.resource.data.adminExists == true
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.createdBy == request.auth.uid;
      allow delete: if false;
    }

    match /activityLog/{logId} {
      allow read: if isAdmin();
      allow create: if isActive()
        && validActivityShape()
        && (
          (request.resource.data.action == 'customer_created'
            && can('add')
            && !exists(/databases/$(database)/documents/customers/$(request.resource.data.targetId))
            && existsAfter(/databases/$(database)/documents/customers/$(request.resource.data.targetId))
            && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.targetId)).data.lastActivityId == logId
            && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.targetId)).data.createdBy == request.auth.uid)
          || (request.resource.data.action == 'customer_updated'
            && can('edit')
            && exists(/databases/$(database)/documents/customers/$(request.resource.data.targetId))
            && existsAfter(/databases/$(database)/documents/customers/$(request.resource.data.targetId))
            && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.targetId)).data.lastActivityId == logId
            && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.targetId)).data.updatedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/customers/$(request.resource.data.targetId)).data.updatedAt == request.time)
          || (request.resource.data.action == 'customer_deleted'
            && can('delete')
            && exists(/databases/$(database)/documents/customers/$(request.resource.data.targetId))
            && !existsAfter(/databases/$(database)/documents/customers/$(request.resource.data.targetId))
            && get(/databases/$(database)/documents/customers/$(request.resource.data.targetId)).data.deleteActivityId == logId)
          || (request.resource.data.action == 'staff_created'
            && isAdmin()
            && !exists(/databases/$(database)/documents/users/$(request.resource.data.targetId))
            && existsAfter(/databases/$(database)/documents/users/$(request.resource.data.targetId))
            && getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.isAdmin == false
            && getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.createdBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.lastActivityId == logId)
          || (request.resource.data.action == 'staff_permissions_changed'
            && isAdmin()
            && exists(/databases/$(database)/documents/users/$(request.resource.data.targetId))
            && existsAfter(/databases/$(database)/documents/users/$(request.resource.data.targetId))
            && get(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.isAdmin == false
            && getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.isAdmin == false
            && get(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.permissions != getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.permissions
            && getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.lastActivityId == logId)
          || (request.resource.data.action == 'staff_removed'
            && isAdmin()
            && exists(/databases/$(database)/documents/users/$(request.resource.data.targetId))
            && existsAfter(/databases/$(database)/documents/users/$(request.resource.data.targetId))
            && get(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.isAdmin == false
            && getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.isAdmin == false
            && get(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.active != getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.active
            && getAfter(/databases/$(database)/documents/users/$(request.resource.data.targetId)).data.lastActivityId == logId)
          || (request.resource.data.action == 'export' && isAdmin())
        );
      allow update, delete: if false;
    }

    match /phoneIndex/{phone} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && (
        (request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['email', 'uid'])
          && request.resource.data.email == request.auth.token.email
          && phone.matches('^03[0-9]{9}$'))
        || isAdmin()
      );
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['email', 'uid'])
        && request.resource.data.email == request.auth.token.email
        && phone.matches('^03[0-9]{9}$'));
    }
  }
}
